{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wd:fireball_ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.03
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "2 + variable.intensity * 3"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.16,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.3 + variable.particle_random_1 * 0.35"
      },
      "minecraft:particle_initial_speed": "0.03 + variable.particle_random_2 * 0.06",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -0.16,
          0
        ],
        "linear_drag_coefficient": 0.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * 0.55",
          "variable.size"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            16
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
