{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wd:evil_fog",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false,
        "velocity": false
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "2 + variable.intensity * 3"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.55,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + variable.particle_random_1 * 0.8"
      },
      "minecraft:particle_initial_speed": "0.01 + variable.particle_random_1 * 0.025",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "0.01 + variable.particle_random_2 * 0.025",
          0
        ],
        "linear_drag_coefficient": 0.18
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (0.7 + variable.particle_random_1 * 0.5)",
          "variable.size * (0.45 + variable.particle_random_2 * 0.35)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            56,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
