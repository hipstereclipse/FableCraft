        "wd:casting": { "type": "int", "range": [0, 18], "default": 0, "client_sync": true },
        "wd:casting_level": { "type": "int", "range": [0, 4], "default": 0, "client_sync": true },
        "wd:mana_ratio": { "type": "float", "range": [0.0, 1.0], "default": 1.0, "client_sync": true },
